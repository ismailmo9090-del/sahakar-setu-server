# Server
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/sahakar_setu
SUPABASE_URL=http://localhost:8000
SUPABASE_ANON_KEY=dev-anon-key
SUPABASE_SERVICE_KEY=dev-service-key

# Redis
REDIS_URL=redis://localhost:6379

# Groq
GROQ_API_KEY=your_groq_api_key
GROQ_MODEL_PRIMARY=openai/gpt-oss-120b
GROQ_MODEL_FALLBACK=openai/gpt-oss-20b

# Vosk
VOSK_MODEL_PATH=./models/vosk-model-small-hi-0.22
VOSK_SAMPLE_RATE=16000

# edge-tts
TTS_VOICE_HINDI=hi-IN-MadhurNeural
TTS_VOICE_ENGLISH=en-IN-NeerjaNeural
TTS_PYTHON_SERVICE_URL=http://localhost:5001

# VAPI
VAPI_API_KEY=your_vapi_key
VAPI_WEBHOOK_SECRET=your_webhook_secret

# Twilio
TWILIO_ACCOUNT_SID=your_sid
TWILIO_AUTH_TOKEN=your_token
TWILIO_PHONE_NUMBER=+1800XXXXXXX
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886

# Security
HMAC_SECRET=your_hmac_secret_min_32_chars
RATE_LIMIT_PER_MINUTE=60

# Tracking
TRACKING_ID_PREFIX=SS
TRACKING_ID_YEAR=2026
